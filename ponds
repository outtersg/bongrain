set -e

Delirant() { local s2 ; while [ -h "$s" ] ; do s2="`readlink "$s"`" ; case "$s2" in [^/]*) s2="`dirname "$s"`/$s2" ;; esac ; s="$s2" ; done ; } ; SCRIPTS() { local s="`command -v "$0"`" ; [ -x "$s" -o ! -x "$0" ] || s="$0" ; case "$s" in */bin/*sh) case "`basename "$s"`" in *.*) true ;; *sh) s="$1" ;; esac ;; esac ; case "$s" in [^/]*) local d="`dirname "$s"`" ; s="`cd "$d" ; pwd`/`basename "$s"`" ;; esac ; Delirant ; s="`dirname "$s"`" ; Delirant ; SCRIPTS="$s" ; } ; SCRIPTS

CHANTS=.

PATH=/home/gui/bin:/Users/gui/bin:$PATH

err()
{
	echo "[31m# $*[0m" >&2
}

# Tout sur une ligne, ou bien couplets présentés comme il se doit?
if false
then
	prefiltre=maj
else
	prefiltre=tasse
fi

maj()
{
	# http://userguide.icu-project.org/transforms/general, cf. Function Calls.
	uconv -f utf-8 -t utf-8 -x '^(.)(.*)>&upper($1)$2;'
}

filtrer()
{
	local r=0
	local f="$1" ; shift
	"$@" < "$f" > "$f.filtre" && cat "$f.filtre" > "$f" || r=$?
	rm "$f.filtre"
	return $r
}

tasse()
{
	awk '/^$/{print mem;print;mem="";next}END{print mem}{if(mem)mem=mem"<text:span text:style-name=\"Filigrane\">/</text:span>&#x200b;";mem=mem$0}' #| sed -e 's#[.!?;:, ]* / # / #g'
}

espace()
{
	# À FAIRE: ajouter les guillemets à la française.
	insec="`echo c2a0 | xxd -p -r`"
	sed -E \
		-e 's/ *$//' \
		-e "s/( |$insec)*"'([!;:?])/\&#x202f;\2/g' \
		-e "s/(’|'|´)/\&#x2019;/g"
	# On n'utilise pas le 00a0 devant les : bien que la typographie française le préconise (aux dernières nouvelles que j'avais dénichées sur internet): moi je trouve ça moche.
}

numero()
{
	# Constitué grâce à http://forum.ubuntu-fr.org/viewtopic.php?id=996191
	case "$1" in
		?) nAff="&#x202f;$1&#x202f;" ;;
		*) nAff="$1" ;;
	esac
	printf "<draw:frame svg:y=\"-`LC_ALL=C awk "BEGIN{print $taillePolice / 20}"`cm\" text:anchor-type=\"as-char\" draw:z-index=\"1\" draw:style-name=\"gr1\"><draw:text-box draw:corner-radius=\"`LC_ALL=C awk "BEGIN{print $taillePolice / 40}"`cm\"><text:p><text:span text:style-name=\"TitreContenu\"><text:s/>$nAff<text:s/></text:span></text:p></draw:text-box></draw:frame><text:s text:c=\"2\"/>" 
}

numeroSimple()
{
	printf "$1. "
}

exprMarges()
{
	# - Reconnaissance des numériques, qu'on met entre parenthèses
	# - Dans les parenthèses, , devient .
	# - Reconnaissance de marges spécifiques suivant leur mot-clé, et transformation en une affectation; découpe préliminaire (par un ; qui sera plus tard transformé en retour à la ligne)
	# - La première (s/// sans g) mesure sans mention est celle de la marge générale
	# - Repérage de ce qui n'aboutit pas à une formule "<var>=(<val>)", suppression de l'affectation (une ligne sans affectation sortira comme une erreur)
	# - Suppression des parenthèses
	echo ";$*;" | sed -E \
		-e 's#[0-9]+([.,][0-9]+)?#(&)#g' \
		-e 's#(\([^)]*),#\1.#g' \
		-e 's# *[+] *(\([^)]*\)) *reliure *#;dimMargeReliure=\1;#g' \
		-e 's#;#;;#g' \
		-e 's#; *(\([^);]*\)) *;#;dimMarge=\1;#' \
		-e 's#;[^=;]*=([^(])#;\1#g' \
		-e 's#;[^=;]*=([^;]*[)][^;])#;\1#g' \
		-e 's#;[^=;]*=([(][^;]*[^);]);#;\1;#g' \
		-e 's#[()]##g' \
	| tr ';' '\012' | grep -v ^$
}

lireMarge()
{
	case "$*" in
		*[=\(\)]*) err "Les marges ne doivent pas inclure d'=, (, ou ): $*" ; return 1 ;;
	esac
	local expr="`exprMarges "$@"`"
	if echo "$expr" | grep -q '^[^=]*$'
	then
		err "Marge: expression(s) non comprise(s):"
		echo "$expr" | grep '^[^=]*$' | while read l ; do err "  $l" ; done
		return 1
	fi
	
	eval "$expr"
}

calculerDimensions()
{
	local v
	
	# Paramètres par défaut.
	
	dimPageL=21.001
	dimPageH=29.7
	dimMarge=1.199
	dimMargeReliure=0
	dimGouttiere=0.3
	
	# Paramètres supplémentaires.
	
	local source NR
	for source in $enTetes
	do
		case "$source" in
			*.txt) true ;;
			*) continue ;;
		esac
		
		NR=0
		while read var val
		do
			NR=`expr $NR + 1`
			case "$var" in
				"#"*) true ;;
				page)
					case "$val" in
						A4|a4) dimPageL=21.001 ; dimPageH=29.7 ;;
						A4p|a4p|A4h|a4h) dimPageL=29.7 ; dimPageH=21.001 ;;
						A5|a5) dimPageL=14.85 ; dimPageH=21.001 ;;
						A5p|a5p|A5h|a5h) dimPageL=21.001 ; dimPageH=14.85 ;;
						*) err "$source:$NR: format de page '$val' non reconnu." ; return 1 ;;
					esac
					;;
				marge)
					lireMarge "$val"
					;;
				police)
					police=
					for v in $val
					do
						case "$v" in
							*[^0-9]*) [ -z "$police" ] || police="$police " ; police="$police $v" ;;
							[0-9]*) taillePolice=$v ;;
						esac
					done
					;;
				i|t|-) true ;;
				*) err "$source:$NR: '$var' non reconnue." ; return 1 ;;
			esac
		done < "$source"
	done
	
	# Calculs.
	
}

imagesEnTete()
{
	local n source image type style x y largeur taille texte numImage
	for source in $enTetes
	do
		case "$source" in
			*.txt) true ;;
			*) continue ;;
		esac
	n=0
		numImage=0
		cat "$source" | grep -v '^#' | while read type reste
		do
			case "$type" in
				-)
					echo '<draw:frame draw:style-name="gr0" text:anchor-type="page" text:anchor-page-number="1" svg:x="0cm" svg:y="0cm" svg:width="21cm" svg:height="'"$reste"'cm" draw:z-index="27"><draw:image xlink:href="Pictures/rien.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame>'
					cp "$SCRIPTS/patronbis/Pictures/rien.png" "$tmpat/Pictures/"
					manifester "Pictures/rien.png"
					;;
				i)
					echo "$reste" | while read style x y largeur image
					do
						imager -l "$largeur" "$style" "$image"
					done
					;;
				t)
		n=`expr $n + 1`
					echo "$reste" | while read taille x y texte
	do
						image="`echo "$source" | sed -e "s/[^.]*$/$n.png/"`" # À FAIRE: regénérer le .png à partir du .txt.
						imager fr1 "$image"
					done
					;;
			esac
		done
	done | tr -d '\012'
}

imager()
{
	local largeur= ppp=300
	if [ "x$1" = x-l ]
	then
		shift
		largeur="$1"
		shift
		case "$largeur" in
			*ppp)
				ppp="`echo "$largeur" | sed -e 's/ppp$//'`"
				largeur=
				;;
		esac
	fi
	local style="$1"
	local image="$2"
	local ancrage='text:anchor-type="page" text:anchor-page-number="1"'
	[ $# -lt 3 ] || ancrage="$3"
		identify -verbose "$image" | grep Geometry: | sed -e 's/[x+]/ /g' | while read bidonavant l h bidonapres
		do
		if [ -z "$largeur" ]
		then
			l="`expr $l \* 2540 / $ppp | sed -e 's/^/000/' -e 's/0*\(\([^0].*\)*.\)\(...\)$/\1.\3/'`"
			h="`expr $h \* 2540 / $ppp | sed -e 's/^/000/' -e 's/0*\(\([^0].*\)*.\)\(...\)$/\1.\3/'`"
		else
			h="`LC_ALL=C awk < /dev/null 'END{ print('$h' * '$largeur' / '$l'); }'`"
			l="$largeur"
		fi
		cp "$image" "$tmpat/Pictures/"
			image="`basename "$image"`"
		numImage="`expr $numImage + 1`"
		echo '<draw:frame draw:style-name="'"$style"'" draw:name="'"$image"'" '"$ancrage"' svg:x="'"$x"'cm" svg:y="'"$y"'cm" svg:width="'"$l"'cm" svg:height="'"$h"'cm" draw:z-index="'"$numImage"'"><draw:image xlink:href="Pictures/'"$image"'" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame>';
			manifester "Pictures/$image"
			done
}

manifester()
{
	local chemin="$1"
	local mime= cheminExpr="`echo "$chemin" | sed -e 's#/#\\\\/#g'`"
	case "$chemin" in
		*.png) mime=image/png ;;
	esac
	filtrer "$tmpat/META-INF/manifest.xml" awk '
BEGIN { reste = 1; }
/manifest:full-path="'"$cheminExpr"'"/{ reste = 0; }
reste&&/manifest:full-path="/&&!/manifest:full-path="Pictures\//&&!/manifest:full-path="\/"/{ print "<manifest:file-entry manifest:full-path=\"'"$chemin"'\" manifest:media-type=\"'"$mime"'\"/>"; reste = 0; }
{ print; }
'
}

ziper()
{
	if command -v 7za > /dev/null 2>&1
	then
		7za a -tzip "$@"
	elif command -v zip > /dev/null 2>&1
	then
		zip -r "$@"
	else
		echo "# Impossible de ziper." >&2
		exit 1
	fi
}

pondre()
{
> /tmp/tdm
> /tmp/params
sortie=/tmp/tmp/f.odt
dest=
	tmpat=patron # Mot-valise de tmp et patron: où l'on entrepose ce qui une fois zippé deviendra le .odt.
modele=complet
	police="Lato"
taillePolice=8
	enTetes=
while [ $# -gt 0 ]
do
	case "$1" in
		-o) shift ; sortie="$1" ;;
			--chants) shift ; CHANTS="$1" ;;
		--de) shift ; cat "$1" > /tmp/tdm ;; # Si l'on reprend une ancienne table des matières (pour ajouter des numéros de chants à la fin plutôt que de repartir de 1).
		--vers) shift ; dest="$1" ;; # Enregistrement de la table des matières.
		-m) shift ; modele="$1" ;; # Modèle à utiliser.
		-t) shift ; taillePolice="$1" ;;
		--long) prefiltre=maj ;;
			--en-tete) shift ; enTetes="$1" ;;
			--temp) shift ; tmpat="$1" ;;
		*) echo "$1" >> /tmp/params ;;
	esac
	shift
done


	avant="$SCRIPTS/patronbis/content.avant.$modele.xml"

n="`sort -n < /tmp/tdm | tail -1 | cut -d ' ' -f 1`"
[ -z "$n" ] && n=0

premiereNouvelle=oui
cat /tmp/params | while read i
do
	cetN="`grep "^[0-9]* $i\( \|$\)" < /tmp/tdm | head -1 | cut -d ' ' -f 1`"
	# Si on n'a pas trouvé le chant dans la table des matières de l'éventuelle précédente édition.
	if [ -z "$cetN" ]
	then
		# Et si c'est le premier de ces nouveaux chants, et que ladite précédente édition comportait au moins un chant.
		[ $premiereNouvelle = oui -a $n -gt 0 ] && echo "+" >> /tmp/tdm || true # Alors on ajoute un séparateur de supplément avant notre chant.
		premiereNouvelle=non
	[ -z "$cetN" ] && n=`expr $n + 1` && cetN="$n" && echo "$cetN $i" >> /tmp/tdm || true
	fi
done

remplace()
{
	local dimMargeI="`LC_ALL=C awk "BEGIN{ print $dimMarge + $dimMargeReliure; }"`"
	# N.B.: le mécanisme de police par défaut (police voulue, police par défaut) ne marche pas.
	local polices="$police"
	case "$police" in
		*,*) police="`echo "$police" | cut -d , -f 1`" ;;
	esac
	local var val options
	for var in numtexte
	do
		eval 'val="'"$var"'"'
		case "$options" in
			"") options='\(' ;;
			*) options="$options\\|" ;;
		esac
		case "$val" in
			"") options="$options! *" ;;
		esac
		options="$options$var"
	done
	options="$options\\)"
	sed \
		-e "s|@pageH@|$dimPageH|g" \
		-e "s|@pageL@|$dimPageL|g" \
		-e "s|@margeH@|$dimMarge|g" \
		-e "s|@margeB@|$dimMarge|g" \
		-e "s|@margeG@|$dimMarge|g" \
		-e "s|@margeD@|$dimMarge|g" \
		-e "s|@margeI@|$dimMargeI|g" \
		-e "s|@margeE@|$dimMarge|g" \
		-e "s|@gouttiere@|$dimGouttiere|g" \
		-e "s|@imagesEnTete@|`imagesEnTete`|" \
		-e "s|@polices@|$polices|g" \
		-e "s|@police@|$police|g" \
		-e "s|@taillePolice@|$taillePolice|g" \
		-e "s|@taillePolice120@|`expr "$taillePolice" \* 120 \
		| sed -e 's/\(..\)$/.\1/'`|g" \
		-e "/#si $options/d"
}
	
	calculerDimensions

	mkdir -p "$tmpat/Pictures"
	
	( cd "$SCRIPTS/patronbis" && tar cf - layout-cache manifest.rdf meta.xml mimetype settings.xml Configurations2 META-INF Thumbnails ) | ( cd "$tmpat" && tar xf - )
(
	# Les numéros sont textuels (ex.: "chant d'entrée", etc.) plutôt que numériques si notre table des matières comporte une majorité de numéros commençant par une lettre:
	numtexte="`awk '/^[1-9]/{--t}/^[a-zA-Z]/{++t}END{if(t>0)print 1}' < /tmp/tdm`"
	nSection=0
	remplace < "$avant"
	IFS="	" # Tabulation obligatoire comme séparateur de colonnes, pour permettre notamment les numéros à espaces (ex.: "prière universelle"); rassurez-vous, le sed ci-dessous accepte encore le format <numéro><espace><fichier> à la place de <numéro><tabulation><fichier>.
	cat /tmp/tdm | sed -e 's/ *#.*//' -e '/^$/d' -e 's/^\([1-9][0-9]*\) /\1	/' | while read cetN i indications
	do
		# Séparation style Supplément.
		if [ "x$cetN" = "x+" ]
		then
			nSection=`expr $nSection + 1`
			echo '<text:section text:style-name="SectionSupplément" text:name="SectionSuppl'$nSection'"><text:p text:style-name="Supplément">✣</text:p></text:section>'
			continue
		fi
		# Chant normal.
		indications="`echo "$indications" | tr '[' '\012' | grep "^$taillePolice]" | sed -e 's/[^]]*]//'`"
		[ -f "$i" -o ! -f "$CHANTS/$i" ] || i="$CHANTS/$i"
		{
			numero $cetN
			{
				# Un chant peut aussi être passé directement dans la table des matières, soit juste un titre, soit un refrain.
				if [ -f "$i" ]
				then
					cat "$i"
				else
					case "$i" in
						"R. "*) echo ; echo ; echo "$i" ;;
						*) echo "$i" ;;
					esac
				fi
			} | espace
		} | $prefiltre | awk '
			function gererIndications(numPara)
			{
				while(numIndication <= nIndications)
				{
					indication = indications[numIndication];
					if(indication == "v")
						couplet = " tassé";
					if(indication == "V")
					{
						couplet = " tassé";
						refrain = " tassé";
					}
					if(match(indication, /…$/))
					{
						if(indication == numPara"…")
						{
							pointilles = 1;
							couplet = "";
							++numIndication;
						}
						return; "return, parce que soit le … porte sur la strophe actuelle et dans ce cas les autres diacritiques (resserrement) porteront sur le suivant, donc on se les laisse pour plus tard, soit ça ne porte pas et on attend."
					}
					++numIndication;
				}
			}
			function finirPara() { if(avant) mem = mem"</text:p>"; avant = 0; if(pointilles) mem = mem"<text:p text:style-name=\"Pointilles\">…</text:p>"; pointilles = 0; }
		 	function aff(dernier) { if(mem) { sub(/@@@/, dernier ? " fin" : "", mem); print mem; mem = ""; } }
			
		 	BEGIN { ORS="\n"; numIndication = 1; nIndications = split("'"$indications"'", indications, /  */); gererIndications(-1); }
			/^$/ { finirPara(); apresvide = 1; next; }
			END { finirPara(); aff(1); }
			FNR == 1 {
				aff(1);
				mem = mem"<text:h text:style-name=\"Titre\" text:outline-level=\"5\">"$0"</text:h>";
				apresvide = 1;
				next;
			}
			{ avant = 1; }
			/^R\. / { aff(); gererIndications("R"); mem = mem"<text:p text:style-name=\"Refrain@@@"refrain"\">"$0; apresvide = 0; next; }
			{ if(apresvide) { aff(); gererIndications(substr($0, 1, index($0, ".") - 1)); mem = mem"<text:p text:style-name=\"Couplet@@@"couplet"\">"$0; apresvide = 0; next; } }
			{ mem = mem"<text:line-break/>"$0; }
		'
	done 
		cat "$SCRIPTS/patronbis/content.apres.xml"
	) > "$tmpat/content.xml"

	remplace < "$SCRIPTS/patronbis/styles.xml" > "$tmpat/styles.xml"

	case "$sortie" in /*) true ;; *) sortie="`pwd`/$sortie" ;; esac
	( cd "$tmpat" && rm -f "$sortie" && find . -type f -name ".bak.*" -exec rm {} \; && ziper "$sortie" . ) > /dev/null 2>&1
echo http://outters.eu/gui/tmp/f.odt

[ -z "$dest" ] || cat /tmp/tdm > "$dest"
}

pondre "$@"
