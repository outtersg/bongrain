# ./ponds --en-tete livret/100_3005_final.png -o /tmp/f10-2015.odt --de tdm.201401 --vers tdm.201512 -t 10 *.txt && /Applications/LibreOffice.app/Contents/MacOS/soffice --headless --convert-to pdf --outdir /tmp/ /tmp/f10-2015.odt && scp /tmp/f10-2015.pdf l:/tmp/tmp/f10-2015.pdf

