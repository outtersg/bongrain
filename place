#!/bin/sh

debroussaille()
{
	sed -e "s/[-'\"() ,] */ /g" -e 's/´/ /g' -e 's/’/ /g' | uconv -f utf-8 -x 'Latin-ASCII' | tr '[A-Z]' '[a-z]' | sed -e 's/^ *//' -e 's/ *$//' | tr -d ' ' # L'espace, en tri français, n'est pas compté comme caractère.
}

TMP=/tmp/temp.place.$$
mkdir $TMP

fais()
{
	titre="`head -1 < "$1" | debroussaille`"
	f="$titre.txt"
	if [ -e "$f" ]
	then
		n=0
		while [ -e "variantes/$titre.$n" ]
		do
			n=`expr "$n" + 1`
		done
		f="variantes/$titre.$n"
	fi
	sed \
		-e 's/[  ]*\([:!?;.]\)/\1/g' \
		-e 's/  *$//' \
		-e "s/´/'/g" \
		-e "s/’/'/g" \
		-e 's/Eglise/Église/g' \
		-e 's/Ecoute/Écoute/g' \
		-e 's/Eternel/Éternel/g' \
		-e 's/coeur/cœur/g' \
		< "$1" > "$f"
}

auSecours()
{
	local moi="`basename "$0"`"
	
	cat >&2 <<TERMINE
# $moi © Guillaume Outters 2013, 2015, 2020
# Nettoie et organise des fichiers de paroles de chants
Utilisation:
  $moi <chant.txt>+
  $moi < <chants.txt>
  <chant.txt>
    Fichier contenant un seul chant; sa première ligne est prise pour titre.
  <chants.txt>
    Fichier contenant plusieurs chants les uns à la suite des autres.
TERMINE
	
	exit 1
}

analyserParametresEtFaire()
{
	while [ $# -gt 0 ]
	do
		case "$1" in
			-h) auSecours ;;
			*) break ;;
		esac
		shift
	done
	
if [ $# -gt 0 ]
then
	for i in "$@"
	do
		fais "$i"
	done
else
	awk '
BEGIN { n = 0; }
/^> / { ++n; if(f) close(f); f = "'$TMP'/chant."n ; print substr($0, 3) > f ; prems = 1; next; }
      { if(FNR == 1) { ++n; f = "'$TMP'/chant."n ; print > f ; prems = 1; next; } }
/^$/ { next; }
/^[R0-9][.]/ { print "" > f; prems = 0; }
{ if(prems) print "" > f; print > f; prems = 0; }
'
	for i in $TMP/*
	do
		fais "$i"
	done
fi
}

rm -Rf $TMP

analyserParametresEtFaire "$@"
