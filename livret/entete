#!/bin/sh

# http://www.imagemagick.org/Usage/compose/#divide
# http://www.imagemagick.org/Usage/photos/#vignettation
#convert IMG_2666.JPG \( +clone -blur 0x40 \) -compose Divide_Src -composite /tmp/corrigee.JPG
convert IMG_2666.JPG -distort Perspective '146,151 0,0   12,1503 0,1300   2826,1492 2756,1300   2700,130 2750,0' -crop 2750x1300+0+0 +repage /tmp/redressee.png
convert /tmp/redressee.png -blur 0x200 -colorspace Gray /tmp/luminosite.png
convert /tmp/redressee.png \( /tmp/luminosite.png -brightness-contrast 30x30 \) -compose Divide_Src -composite -auto-level /tmp/corrigee.png
# http://blog.guillaumefoucart.be/article3/bien-redimensionner-ses-photos-avec-imagemagick
# Éventuellement:
#convert /tmp/corrigee.png -unsharp 0x1.6 /tmp/corrigee2.png
#convert /tmp/corrigee.png -unsharp 120x100+0.5 /tmp/corrigee3.png
# http://blog.barijaona.com/photos/workflow4.html; très intéressant, il y a sans doute d'autres scripts à y récupérer.
#convert /tmp/corrigee.png -unsharp 60x50+1+0.0079 /tmp/corrigee3.png
# Sinon sous Gimp, rayon 200, quantité 0,3; cf. correspondances sur http://redskiesatnight.com/2005/04/06/sharpening-using-image-magick/
convert /tmp/corrigee.png -crop 2750x850+0+143 +repage /tmp/bande.png
# Le gradient suivant est un peu trop abrupt en début et fin de course; on le sinusoïdise pour adoucir les atterrissages.
#convert /tmp/bande.png -alpha set -channel A -sparse-color Barycentric '1000,449.5 #ffffffff   1000,849.5 #ffffff00' -channel RGBA /tmp/degradee.png
convert /tmp/bande.png -alpha set -channel A -fx 'sin(max(min(h-j-0,400),0)/400*pi/2)' -channel RGBA /tmp/degradee.png
# http://stackoverflow.com/questions/718314/rounding-corners-of-pictures-with-imagemagick
convert -size 2750x850 xc:none -draw 'roundrectangle 0,0,2750,2000,75,75' /tmp/masque.png
convert /tmp/degradee.png -matte /tmp/masque.png -compose DstIn -composite IMG_2666_final.png
